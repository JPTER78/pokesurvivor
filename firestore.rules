rules_version = '2';

// Reglas de seguridad de PokéSurvivor.
//   saves/{uid}            partida: sólo su dueño
//   names/{apodo}          reserva de apodos únicos (en minúsculas)
//   profiles/{uid}         apodo público de cada jugador
//   friendships/{a_b}      solicitudes y amistades entre dos jugadores
//   runs/{uid}             cuándo empezó tu última partida (anti-trampas del ranking)
//   lb/{tabla}/e/{id}      ranking de tiempo aguantado
//   reports/{tabla__id__uid}  reportes de marcas sospechosas (sólo los lee el admin)
//   lbs/{tabla}            resumen con el top 50 de cada tabla
//   pres/{uid}             en línea (aproximado) · inv/{para_de} invitaciones
// Todo lo demás está cerrado.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // Moderación (pantalla oculta del juego, js/ui/mod-ui.js): sólo esta cuenta.
    function admin() { return signedIn() && me() in ['rshaa5gKD3fXw6lE4PPXITbowaG2']; }
    // Tope de escrituras (20-10-2026): un documento no se puede volver a escribir
    // hasta pasados `secs` segundos desde `last` (su hora guardada). El juego
    // escribe mucho menos que eso; esto sólo frena un bucle (un juego trucado o
    // un fallo), y lo rechazado no se cobra como escritura.
    function every(last, secs) { return !(last is timestamp) || request.time > last + duration.value(secs, 's'); }

    // ---------- partida guardada ----------
    // Sólo su dueño la lee y la escribe. Ya no se marca a nadie solo (14-10-2026:
    // los márgenes contra partidas imposibles dejaban fuera del ranking a gente
    // legal). Lo único que deja a alguien sin ranking es que el admin lo banee
    // (ban = true; el campo viejo "sus" ya no cuenta para nada). El jugador no
    // puede quitarse el baneo: si está, sus guardados tienen que llevarlo.
    match /saves/{uid} {
      allow read: if signedIn() && me() == uid;
      allow read: if admin();
      // (Baneado no: sin documento, validEntry da por hecho que no hay baneo.)
      allow delete: if signedIn() && me() == uid && resource.data.get('ban', false) == false;

      allow create: if signedIn() && me() == uid && validSaveDoc() && saneSave(request.resource.data.save)
        && request.resource.data.get('ban', false) == false;
      allow update: if signedIn() && me() == uid && validSaveDoc() && saneSave(request.resource.data.save)
        && request.resource.data.get('ban', false) == resource.data.get('ban', false)
        && every(resource.data.updatedAt, 20);
      // El admin sólo puede banear o desbanear (y quitar la marca vieja).
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ban', 'sus'])
        && request.resource.data.get('ban', false) is bool;
    }

    function validSaveDoc() {
      return request.resource.data.keys().hasOnly(['save', 'updatedAt', 'v', 'sus', 'ban'])
        && request.resource.data.save is map
        && request.resource.data.v is int
        && request.resource.data.get('ban', false) is bool
        && request.resource.data.updatedAt == request.time;
    }
    function tk(s, k) { return s.get('tickets', {}).get(k, 0); }
    // Sólo que los números tengan sentido (el juego ya los limpia al cargar).
    function saneSave(s) {
      return s.get('coins', 0) is number && s.get('coins', 0) >= 0
        && tk(s, 't1') is number && tk(s, 't1') >= 0
        && tk(s, 't10') is number && tk(s, 't10') >= 0;
    }

    // ---------- apodos ----------

    match /names/{lower} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && lower.size() >= 3 && lower.size() <= 16
        && lower == lower.lower();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Perfil público: apodo, 3 favoritos, título, mejores marcas y medallas.
    // Récords del perfil: sólo números (lo que pinta el perfil; nada de texto).
    function validBest(b) {
      return b is map && b.keys().hasOnly(['solo', 'group', 'level', 'bosses', 'legends', 'kills', 'medals'])
        && b.get('solo', 0) is int && b.get('group', 0) is int && b.get('level', 0) is int && b.get('bosses', 0) is int
        && b.get('legends', 0) is int && b.get('kills', 0) is int && b.get('medals', 0) is int;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'lower', 'at', 'favs', 'title', 'best', 'medals'])
        && request.resource.data.name is string
        && request.resource.data.lower == request.resource.data.name.lower()
        && request.resource.data.at == request.time
        && (!('favs' in request.resource.data) || (request.resource.data.favs is list && request.resource.data.favs.size() <= 3))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 40))
        && (!('best' in request.resource.data) || validBest(request.resource.data.best))
        && (!('medals' in request.resource.data) || (request.resource.data.medals is list && request.resource.data.medals.size() <= 8))
        && getAfter(/databases/$(database)/documents/names/$(request.resource.data.lower)).data.uid == me()
        && (resource == null || every(resource.data.at, 20));
      allow delete: if signedIn() && me() == uid;
    }

    // ---------- amigos ----------
    // Un documento por pareja, con id "uidMenor_uidMayor".

    match /friendships/{pid} {
      allow read: if signedIn() && (resource == null || me() in resource.data.users);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['users', 'from', 'to', 'status', 'names', 'at'])
        && request.resource.data.from == me()
        && request.resource.data.to != me()
        && request.resource.data.status == 'pending'
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && me() in request.resource.data.users
        && request.resource.data.to in request.resource.data.users
        && pid == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.names is map
        && request.resource.data.at == request.time;
      // Sólo quien la recibe puede aceptarla.
      allow update: if signedIn()
        && resource.data.to == me()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'at', 'names'])
        && request.resource.data.status == 'ok';
      allow delete: if signedIn() && me() in resource.data.users;
    }

    // ---------- ranking ----------

    // Hora de inicio de partida: se quitó el 20-10-2026 (era 1/3 de las escrituras
    // y validEntry la leía en cada marca). Sólo se puede borrar lo que quede.
    match /runs/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if false;
    }

    // Una entrada sólo se puede mejorar, nunca empeorar. Anti-trampas:
    //   - no más de 45 min (desde el 18-10-2026 la Sentencia de Arceus deja KO
    //     de un toque hacia el minuto 40; antes era 1 h y se llegaba huyendo)
    //   - nivel y derrotados con margen de sobra (un grupo de 4 muy bueno)
    //   - la cuenta no puede estar baneada por el admin (saves/{uid}.ban; si aún
    //     no ha guardado nunca en la nube, no tiene documento y no está baneada)
    function validEntry(board, id) {
      let d = request.resource.data;
      let sv = /databases/$(database)/documents/saves/$(me());
      return d.keys().hasOnly(['t', 'uids', 'names', 'dex', 'shiny', 'lv', 'kills', 'at'])
        && d.t is int && d.t > 0 && d.t <= 2700
        && d.lv is int && d.lv >= 1 && d.lv <= 10 + d.t / 4
        && d.kills is int && d.kills >= 0 && d.kills <= 100 + d.t * 12
        && (!exists(sv) || get(sv).data.get('ban', false) == false)
        && d.uids is list && me() in d.uids
        && d.names is list && d.names.size() == d.uids.size()
        && d.dex is list && d.dex.size() == d.uids.size()
        && d.shiny is list && d.shiny.size() == d.uids.size()
        && d.at == request.time
        && (board.matches('s_.*')
              ? (d.uids.size() == 1 && id == me())
              : (d.uids.size() >= 2 && d.uids.size() <= 4 && id == d.uids.join('_')))
        && (resource == null || d.t > resource.data.t);
    }

    match /lb/{board}/e/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validEntry(board, id);
      allow delete: if signedIn() && (me() in resource.data.uids || admin());
    }

    // Resumen con el top 50 de cada tabla (lo que se lee al mirar el ranking).
    //   top: { id: { t, uids, names, dex, shiny, lv, kills } }
    //   me:  la fila que añades o mejoras (debe coincidir con tu marca validada,
    //        escrita en la misma transacción)
    //   ev:  la fila que sale del top (sólo si tiene menos tiempo que la tuya)
    // Al borrar la cuenta: me = '' y ev = una fila tuya que se quita.
    function validTop(board) {
      let d = request.resource.data;
      let old = resource == null ? {} : resource.data.top;
      let changed = d.top.diff(old).affectedKeys();
      return d.keys().hasOnly(['top', 'me', 'ev'])
        && d.top is map && d.top.size() <= 50
        && d.me is string && d.ev is string
        && (d.me == '' ? (removeMine(d, old, changed) || adminRemove(d, old)) : addMine(board, d, old, changed));
    }
    // Moderación: el admin sólo puede QUITAR filas del top.
    function adminRemove(d, old) {
      return admin() && old.keys().hasAll(d.top.keys()) && d.top.diff(old).changedKeys().size() == 0;
    }
    function addMine(board, d, old, changed) {
      let e = getAfter(/databases/$(database)/documents/lb/$(board)/e/$(d.me)).data;
      let row = d.top[d.me];
      // La fila del resumen es una COPIA exacta de la marca ya validada (validEntry):
      // también nivel, derrotados y shiny (18-10-2026: sin esto se podía meter
      // texto con código en el "nivel" y se ejecutaba en quien abría el ranking).
      // shiny es opcional: las versiones del juego de antes del 18-10 no lo ponían.
      return me() in e.uids
        && changed.hasOnly([d.me, d.ev])
        && row.keys().hasOnly(['t', 'uids', 'names', 'dex', 'shiny', 'lv', 'kills'])
        && row.t == e.t && row.uids == e.uids && row.names == e.names && row.dex == e.dex
        && row.lv == e.lv && row.kills == e.kills
        && (!('shiny' in row) || row.shiny == e.shiny)
        && (d.ev == '' || (!(d.ev in d.top) && d.ev in old && old[d.ev].t <= e.t));
    }
    function removeMine(d, old, changed) {
      return d.ev in old && me() in old[d.ev].uids && !(d.ev in d.top) && changed.hasOnly([d.ev]);
    }

    match /lbs/{board} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validTop(board);
    }

    // Presencia aproximada: "en línea" si at es de hace menos de unos minutos.
    match /pres/{uid} {
      allow read: if signedIn();
      // Quitado el 20-10-2026 (era 1/4 de las escrituras): nadie puede escribirlo,
      // así tampoco gastan las versiones viejas del juego. Sólo se puede borrar.
      allow create, update: if false;
      allow delete: if signedIn() && me() == uid;
    }

    // Invitaciones a una sala: id "para_de". Sólo entre amigos confirmados.
    match /inv/{id} {
      allow read: if signedIn() && (resource == null || me() == resource.data.to || me() == resource.data.from);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['to', 'from', 'room', 'name', 'at'])
        && request.resource.data.from == me()
        && id == request.resource.data.to + '_' + me()
        && request.resource.data.room is string && request.resource.data.room.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.at == request.time
        && get(/databases/$(database)/documents/friendships/$(request.resource.data.to < me() ? request.resource.data.to + '_' + me() : me() + '_' + request.resource.data.to)).data.status == 'ok';
      allow delete: if signedIn() && (me() == resource.data.to || me() == resource.data.from);
    }

    // ---------- reportes ----------
    // Un reporte por jugador y marca (id "tabla__marca__tuUid"). Los lee y
    // borra el admin desde la pantalla oculta de moderación.
    match /reports/{rid} {
      allow read, delete: if admin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['board', 'e', 'names', 't', 'by', 'at'])
        && request.resource.data.by == me()
        && request.resource.data.board is string && request.resource.data.board.size() <= 40
        && request.resource.data.e is string && request.resource.data.e.size() <= 160
        && request.resource.data.names is list && request.resource.data.names.size() <= 4
        && request.resource.data.t is int
        && request.resource.data.at == request.time
        && rid == request.resource.data.board + '__' + request.resource.data.e + '__' + me();
    }

    // Para borrar todas tus marcas al borrar la cuenta (consulta de grupo).
    match /{path=**}/e/{id} {
      allow read: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
