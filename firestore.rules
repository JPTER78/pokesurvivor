rules_version = '2';

// Reglas de seguridad de Pokémon Survivors.
// Cada jugador sólo puede leer, escribir y borrar SU partida: saves/{su uid}.
// Todo lo demás está cerrado.
service cloud.firestore {
  match /databases/{database}/documents {

    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['save', 'updatedAt', 'v'])
        && request.resource.data.save is map
        && request.resource.data.v is int
        && request.resource.data.updatedAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
