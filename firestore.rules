rules_version = '2';

// Reglas de seguridad de PokéSurvivor.
//   saves/{uid}            partida: sólo su dueño
//   names/{apodo}          reserva de apodos únicos (en minúsculas)
//   profiles/{uid}         apodo público de cada jugador
//   friendships/{a_b}      solicitudes y amistades entre dos jugadores
//   runs/{uid}             cuándo empezó tu última partida (anti-trampas)
//   lb/{tabla}/e/{id}      ranking de tiempo aguantado (marcas validadas)
//   lbs/{tabla}            resumen con el top 50 de cada tabla
//   pres/{uid}             en línea (aproximado) · inv/{para_de} invitaciones
// Todo lo demás está cerrado.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    function validSave(s) {
      return s.keys().hasAll(['v', 'name', 'coins'])
        && s.v is int
        && s.name is string && s.name.size() >= 3 && s.name.size() <= 16
        && s.coins is int && s.coins >= 0 && s.coins <= 10000000
        && (!('tickets' in s) || (s.tickets is map
            && (!('t1' in s.tickets) || (s.tickets.t1 is int && s.tickets.t1 >= 0 && s.tickets.t1 <= 99999))
            && (!('t10' in s.tickets) || (s.tickets.t10 is int && s.tickets.t10 >= 0 && s.tickets.t10 <= 99999))))
        && (!('stats' in s) || s.stats is map)
        && (!('owned' in s) || s.owned is map)
        && (!('shiny' in s) || s.shiny is map)
        && (!('upgrades' in s) || s.upgrades is map)
        && (!('pupg' in s) || s.pupg is map)
        && (!('pity' in s) || s.pity is map)
        && (!('legends' in s) || s.legends is map)
        && (!('arenas' in s) || s.arenas is map)
        && (!('itemsFound' in s) || s.itemsFound is map)
        && (!('evoMoves' in s) || s.evoMoves is map)
        && (!('ach' in s) || s.ach is map)
        && (!('missions' in s) || s.missions is map)
        && (!('profile' in s) || s.profile is map)
        && (!('partner' in s) || s.partner == null || (s.partner is int && s.partner >= 1 && s.partner <= 1025))
        && (!('partnerShiny' in s) || s.partnerShiny is bool)
        && (!('starter' in s) || s.starter == null || (s.starter is int && s.starter >= 1 && s.starter <= 1025))
        && (!('created' in s) || s.created is int)
        && (!('updated' in s) || s.updated is int);
    }

    match /saves/{uid} {
      allow read, delete: if signedIn() && me() == uid;

      allow create, update: if signedIn()
        && me() == uid
        && request.resource.data.keys().hasOnly(['save', 'updatedAt', 'v'])
        && request.resource.data.save is map
        && validSave(request.resource.data.save)
        && request.resource.data.v is int
        && request.resource.data.updatedAt == request.time;
    }

    // ---------- apodos ----------

    match /names/{lower} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && lower.size() >= 3 && lower.size() <= 16
        && lower == lower.lower()
        && getAfter(/databases/$(database)/documents/profiles/$(me())).data.lower == lower;
      allow delete: if signedIn() && resource.data.uid == me();
    }

    function validProfileBest(b) {
      return b.keys().hasOnly(['solo', 'group', 'level', 'bosses', 'legends', 'kills', 'medals'])
        && (!('solo' in b) || (b.solo is int && b.solo >= 0 && b.solo <= 21600))
        && (!('group' in b) || (b.group is int && b.group >= 0 && b.group <= 21600))
        && (!('level' in b) || (b.level is int && b.level >= 0 && b.level <= 1000))
        && (!('bosses' in b) || (b.bosses is int && b.bosses >= 0))
        && (!('legends' in b) || (b.legends is int && b.legends >= 0 && b.legends <= 100))
        && (!('kills' in b) || (b.kills is int && b.kills >= 0 && b.kills <= 10000000))
        && (!('medals' in b) || (b.medals is int && b.medals >= 0 && b.medals <= 100));
    }

    // Perfil público: apodo, 3 favoritos, título, mejores marcas y medallas.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'lower', 'at', 'favs', 'title', 'best', 'medals'])
        && request.resource.data.name is string
        && request.resource.data.lower == request.resource.data.name.lower()
        && request.resource.data.at == request.time
        && (!('favs' in request.resource.data) || (request.resource.data.favs is list && request.resource.data.favs.size() <= 3))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 40))
        && (!('best' in request.resource.data) || (request.resource.data.best is map && validProfileBest(request.resource.data.best)))
        && (!('medals' in request.resource.data) || (request.resource.data.medals is list && request.resource.data.medals.size() <= 8))
        && getAfter(/databases/$(database)/documents/names/$(request.resource.data.lower)).data.uid == me();
      allow delete: if signedIn() && me() == uid;
    }

    // ---------- amigos ----------
    // Un documento por pareja, con id "uidMenor_uidMayor".

    match /friendships/{pid} {
      allow read: if signedIn() && (resource == null || me() in resource.data.users);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['users', 'from', 'to', 'status', 'names', 'at'])
        && request.resource.data.from == me()
        && request.resource.data.to != me()
        && request.resource.data.status == 'pending'
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && me() in request.resource.data.users
        && request.resource.data.to in request.resource.data.users
        && pid == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.names is map
        && request.resource.data.at == request.time;
      // Sólo quien la recibe puede aceptarla.
      allow update: if signedIn()
        && resource.data.to == me()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'at', 'names'])
        && request.resource.data.status == 'ok';
      allow delete: if signedIn() && me() in resource.data.users;
    }

    // ---------- ranking ----------

    match /runs/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn()
        && me() == uid
        && request.resource.data.keys().hasOnly(['startedAt', 'mode'])
        && request.resource.data.startedAt == request.time;
    }

    // Una entrada no puede durar más que el tiempo real desde que empezó tu
    // partida (runs/{uid}), y sólo se puede mejorar, nunca empeorar.
    // Anti-trampas: el nivel y los derrotados tienen que cuadrar con el tiempo
    // (con margen de sobra para un jugador muy bueno o un grupo de 4).
    function validEntry(board, id) {
      let d = request.resource.data;
      let run = get(/databases/$(database)/documents/runs/$(me())).data;
      return d.keys().hasOnly(['t', 'uids', 'names', 'dex', 'shiny', 'lv', 'kills', 'at'])
        && d.t is int && d.t > 0 && d.t <= 21600
        && d.t <= (request.time - run.startedAt).seconds() + 15
        && d.lv is int && d.lv >= 1 && d.lv <= 10 + d.t / 4
        && d.kills is int && d.kills >= 0 && d.kills <= 100 + d.t * 12
        && d.uids is list && me() in d.uids
        && d.names is list && d.names.size() == d.uids.size()
        && d.dex is list && d.dex.size() == d.uids.size()
        && d.shiny is list && d.shiny.size() == d.uids.size()
        && d.at == request.time
        && (board.matches('s_.*')
              ? (d.uids.size() == 1 && id == me())
              : (d.uids.size() >= 2 && d.uids.size() <= 4 && id == d.uids.join('_')
                 && d.uids[0] < d.uids[1]
                 && (d.uids.size() < 3 || d.uids[1] < d.uids[2])
                 && (d.uids.size() < 4 || d.uids[2] < d.uids[3])))
        && (resource == null || (d.t > resource.data.t && resource.data.uids == d.uids));
    }

    match /lb/{board}/e/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validEntry(board, id);
      allow delete: if signedIn() && me() in resource.data.uids;
    }

    // Resumen con el top 50 de cada tabla (lo que se lee al mirar el ranking).
    //   top: { id: { t, uids, names, dex, shiny, lv, kills } }
    //   me:  la fila que añades o mejoras (debe coincidir con tu marca validada,
    //        escrita en la misma transacción)
    //   ev:  la fila que sale del top (sólo si tiene menos tiempo que la tuya)
    // Al borrar la cuenta: me = '' y ev = una fila tuya que se quita.
    function validTop(board) {
      let d = request.resource.data;
      let old = resource == null ? {} : resource.data.top;
      let changed = d.top.diff(old).affectedKeys();
      return d.keys().hasOnly(['top', 'me', 'ev'])
        && d.top is map && d.top.size() <= 50
        && d.me is string && d.ev is string
        && (d.me == '' ? removeMine(d, old, changed) : addMine(board, d, old, changed));
    }
    function addMine(board, d, old, changed) {
      let e = getAfter(/databases/$(database)/documents/lb/$(board)/e/$(d.me)).data;
      let row = d.top[d.me];
      let alreadyIn = d.me in old;
      let full = old.size() >= 50;
      return me() in e.uids
        && (d.me in d.top)
        && (d.ev == '' ? changed.hasOnly([d.me]) : changed.hasOnly([d.me, d.ev]))
        && row.t == e.t && row.uids == e.uids && row.names == e.names && row.dex == e.dex
        && row.lv == e.lv && row.kills == e.kills && row.shiny == e.shiny
        && (alreadyIn
            ? (d.ev == '')
            : (full
                ? (d.ev != '' && !(d.ev in d.top) && d.ev in old && old[d.ev].t <= e.t)
                : (d.ev == '')));
    }
    function removeMine(d, old, changed) {
      return d.ev in old && me() in old[d.ev].uids && !(d.ev in d.top) && changed.hasOnly([d.ev]);
    }

    match /lbs/{board} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validTop(board);
    }

    // Presencia aproximada: "en línea" si at es de hace menos de unos minutos.
    match /pres/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['at', 'room', 'play', 'on'])
        && request.resource.data.at == request.time
        && request.resource.data.room is string && request.resource.data.room.size() <= 40
        && request.resource.data.play is bool && request.resource.data.on is bool;
      allow delete: if signedIn() && me() == uid;
    }

    // Invitaciones a una sala: id "para_de". Sólo entre amigos confirmados.
    match /inv/{id} {
      allow read: if signedIn() && (resource == null || me() == resource.data.to || me() == resource.data.from);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['to', 'from', 'room', 'name', 'at'])
        && request.resource.data.from == me()
        && id == request.resource.data.to + '_' + me()
        && request.resource.data.room is string && request.resource.data.room.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.at == request.time
        && get(/databases/$(database)/documents/friendships/$(request.resource.data.to < me() ? request.resource.data.to + '_' + me() : me() + '_' + request.resource.data.to)).data.status == 'ok';
      allow delete: if signedIn() && (me() == resource.data.to || me() == resource.data.from);
    }

    // Para borrar todas tus marcas al borrar la cuenta (consulta de grupo).
    match /{path=**}/e/{id} {
      allow read: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
