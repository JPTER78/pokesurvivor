{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null && data.child('m').child(auth.uid).exists()",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        "host": {
          ".read": "auth != null"
        },
        "open": {
          ".read": "auth != null"
        },
        "m": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || data.exists() || (root.child('rooms').child($room).child('open').val() === true))"
          }
        },
        "q": {
          "$to": {
            ".read": "auth != null && auth.uid === $to",
            "$msg": {
              ".write": "auth != null && (auth.uid === $to || root.child('rooms').child($room).child('m').child(auth.uid).exists())",
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 200000)"
            }
          }
        }
      }
    },
    "stats": {
      "online": {
        ".read": true,
        ".write": true,
        ".validate": "newData.isNumber() && ((!data.exists() && (newData.val() === 1 || newData.val() === -1)) || (data.exists() && (newData.val() === data.val() + 1 || newData.val() === data.val() - 1)))"
      }
    }
  }
}
